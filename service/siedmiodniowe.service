[Unit]
Description=Siedmiodniowe Cele Flask App
After=network.target

[Service]
Type=notify
User=webapp
Group=www-data
WorkingDirectory=/var/www/siedmiodniowe-cele
Environment="PATH=/var/www/siedmiodniowe-cele/venv/bin"
ExecStart=/var/www/siedmiodniowe-cele/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5000 \
    --timeout 120 \
    --log-level info \
    "siedmiodniowe_cele.app:create_app()"

[Install]
WantedBy=multi-user.target
